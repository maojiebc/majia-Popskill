          "stringUnit": {
            "state": "translated",
            "value": "Runs only while Popskill is open. Automatic upgrades require recognized agents with eligible channels and paths; upstream releases are not guaranteed to be problem-free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
