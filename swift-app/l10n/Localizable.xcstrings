        }
      }
    },
    "%@ 本地改过，已跳过覆盖。要覆盖请选「仍要覆盖本地修改」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was edited locally and was not overwritten. Choose “Overwrite local edits anyway” to replace it."
